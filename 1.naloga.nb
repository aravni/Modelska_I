Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "v", ",", " ", "\[Lambda]", ",", " ", "t0", ",", "v0", ",", "C0", ",", "p1",
    ",", "p2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v0", "=", 
   RowBox[{"90", "/", "3.6"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"euler", " ", "=", " ", 
  RowBox[{"EulerEquations", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{
       RowBox[{"v", "'"}], "[", "t", "]"}], "p1"], "+", 
     RowBox[{"C0", " ", 
      SuperscriptBox[
       RowBox[{"v", "[", "t", "]"}], "p2"]}], "-", 
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"v", "[", "t", "]"}]}]}], ",", 
    RowBox[{"v", "[", "t", "]"}], ",", "t"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"re\[SHacek]", "=", 
  RowBox[{
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"euler", ",", 
       RowBox[{
        RowBox[{"v", "[", "0", "]"}], "==", "v0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "'"}], "[", "t0", "]"}], "==", "0"}]}], "}"}], ",", "v",
