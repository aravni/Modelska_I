Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Load", " ", "signal", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"signal", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
