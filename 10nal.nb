       "\"\</mnt/nvme0n1p3/Users/ravni/Documents/FS/Modelska analiza \
I/podatki/signal0.dat\>\"", ",", "\"\<Data\>\""}], "]"}], "//", "Flatten"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "response", " ", "function"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"responseFunction", "[", 
      RowBox[{"t_", ",", "tau_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "tau"}], ")"}]}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Abs", "[", "t", "]"}]}], "/", "tau"}], "]"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "time", " ", "array"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "signal", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "response", " ", "function", " ", "data", " ", "using", 
     " ", "the", " ", "defined", " ", "function"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"responseData", "=", 
     RowBox[{"responseFunction", "[", 
      RowBox[{"t", ",", "tau"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
    "Perform", " ", "Fourier", " ", "transform", " ", "of", " ", "the", " ", 
     "signal", " ", "and", " ", "response", " ", "function"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"signalFT", "=", 
     RowBox[{"Fourier", "[", "signal", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"responseFT", "=", 
     RowBox[{"Fourier", "[", "responseData", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "Wiener", " ", "filter", " ", "for", " ", "deconvolution"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deconvolvedFT", "=", 
     RowBox[{"WienerFilter", "[", 
      RowBox[{"signalFT", ",", "responseFT"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Inverse", " ", "Fourier", " ", "transform", " ", "to", " ", "obtain", 
     " ", "the", " ", "deconvolved", " ", "signal"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"deconvolved", "=", 
     RowBox[{"InverseFourier", "[", "deconvolvedFT", "]"}]}], 
    ";"}]}]}]], "Input",
